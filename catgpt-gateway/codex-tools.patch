+def _responses_tool_catalog(tools: list[dict]) -> dict[str, dict]:
+    """Use qualified prompt names while retaining the original wire identity."""
+    catalog = {}
+    def visit(items, namespace=None):
+        for tool in items:
+            kind = tool.get("type")
+            name = tool.get("name")
+            if kind == "namespace":
+                if namespace or not name or not isinstance(tool.get("tools"), list):
+                    raise HTTPException(status_code=400, detail="Invalid tool namespace")
+                visit(tool["tools"], name)
+                continue
+            if kind not in ("function", "custom"):
+                log.warning("Unsupported Responses tool type: %s", kind)
+                continue
+            if not isinstance(name, str) or not name:
+                raise HTTPException(status_code=400, detail="Client tool name is missing")
+            key = f"{namespace}.{name}" if namespace else name
+            if key in catalog:
+                raise HTTPException(status_code=400, detail="Duplicate client tool name")
+            catalog[key] = {**tool, "namespace": namespace}
+    visit(tools)
+    if tools and not catalog:
+        raise HTTPException(status_code=400, detail="No supported client tools: expected function or custom tools")
+    return catalog
