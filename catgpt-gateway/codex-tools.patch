+def _responses_call_item(tc: ToolCall, catalog: dict) -> dict:
+    tool = catalog.get(tc.function.name)
+    if tool is None:
+        raise HTTPException(status_code=502, detail="Model returned an unknown client tool")
+    try:
+        arguments = json.loads(tc.function.arguments)
+    except (ValueError, TypeError):
+        raise HTTPException(status_code=502, detail="Model returned invalid tool arguments")
+    if not isinstance(arguments, dict):
+        raise HTTPException(status_code=502, detail="Tool arguments must be an object")
+    item = {"id": f"fc_{uuid.uuid4().hex[:24]}", "type": "function_call",
+            "call_id": tc.id, "name": tool["name"], "status": "completed",
+            "arguments": tc.function.arguments}
+    if tool.get("namespace"):
+        item["namespace"] = tool["namespace"]
+    if tool["type"] == "custom":
+        if set(arguments) != {"input"} or not isinstance(arguments["input"], str):
+            raise HTTPException(status_code=502, detail="Custom tool requires a string input")
+        item.update(id=f"ctc_{uuid.uuid4().hex[:24]}", type="custom_tool_call", input=arguments["input"])
+        del item["arguments"]
+    return item
 
 
